{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "framework": "node",
      "entrypoint": "dist/index.mjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/backend",
      "destination": { "service": "backend", "path": "/api/backend" }
    },
    {
      "source": "/api/backend/:path*",
      "destination": { "service": "backend", "path": "/api/backend/:path*" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
